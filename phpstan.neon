includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
    tmpDir: build/phpstan
    # The spec is untrusted input, so the parser and emitter keep defensive
    # runtime checks even where PHPDoc types claim certainty. Do not treat
    # PHPDoc types as certain, so those guards are not flagged as redundant.
    treatPhpDocTypesAsCertain: false
