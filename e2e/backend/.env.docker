# Container env for the e2e demo backend. This is NOT the local dev .env (which
# is gitignored): it ships in the image so the demo boots with zero database.
#
# The API routes are stateless and persist pets through the file-backed PetStore
# (storage/app/petstore.json), so the demo needs no database at all. Session,
# cache, and queue drivers are therefore switched to array/file here, overriding
# the database defaults in .env.example. APP_KEY is generated at build time.
APP_NAME=PetstoreDemo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# No database: the demo is fully file-backed.
DB_CONNECTION=sqlite
DB_DATABASE=/dev/null

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=log
