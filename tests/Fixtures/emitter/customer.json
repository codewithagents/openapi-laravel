{
    "openapi": "3.0.3",
    "info": { "title": "Customer API", "version": "1.0.0" },
    "paths": {},
    "components": {
        "schemas": {
            "Customer": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                    "id": { "type": "integer", "minimum": 1 },
                    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
                    "email_address": { "type": "string", "format": "email", "nullable": true },
                    "age": { "type": "integer", "minimum": 0, "maximum": 120 },
                    "website": { "type": "string", "format": "uri" },
                    "sku": { "type": "string", "pattern": "^[A-Z]{3}-\\d+$" },
                    "status": { "$ref": "#/components/schemas/CustomerStatus" },
                    "tags": {
                        "type": "array",
                        "maxItems": 10,
                        "items": { "$ref": "#/components/schemas/Tag" }
                    },
                    "address": {
                        "type": "object",
                        "properties": {
                            "city": { "type": "string" },
                            "zip": { "type": "string" }
                        }
                    }
                }
            },
            "CustomerStatus": {
                "type": "string",
                "enum": ["active", "inactive", "pending-review"]
            },
            "Tag": {
                "type": "object",
                "required": ["label"],
                "properties": {
                    "label": { "type": "string", "maxLength": 50 }
                }
            }
        }
    }
}
