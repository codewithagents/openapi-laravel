{
    "name": "codewithagents/openapi-laravel",
    "description": "Generate Laravel models (spatie/laravel-data classes, validation rules, enums) from an OpenAPI spec. The spec is the source of truth.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "openapi",
        "laravel",
        "codegen",
        "laravel-data",
        "spec-first",
        "contract-first"
    ],
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "devizzent/cebe-php-openapi": "^1.1",
        "illuminate/support": "^11.0|^12.0",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.6",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-type-coverage": "^3.0",
        "phpstan/phpstan": "^2.0",
        "spatie/pest-plugin-snapshots": "^2.0"
    },
    "bin": [
        "bin/openapi-laravel"
    ],
    "autoload": {
        "psr-4": {
            "CodeWithAgents\\OpenApiLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeWithAgents\\OpenApiLaravel\\Tests\\": "tests/",
            "CodeWithAgents\\OpenApiLaravel\\Examples\\Petstore\\": "examples/petstore/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeWithAgents\\OpenApiLaravel\\OpenApiLaravelServiceProvider"
            ]
        }
    },
    "scripts": {
        "pint": "pint",
        "lint": "pint --test",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "@php -d memory_limit=512M vendor/bin/pest",
        "test:type": "@php -d memory_limit=512M vendor/bin/pest --type-coverage --min=100",
        "test:mutate": "@php -d memory_limit=-1 vendor/bin/pest --mutate --covered-only --min=90",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --no-progress",
        "qa": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
